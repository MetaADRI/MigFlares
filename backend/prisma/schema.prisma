// =====================================================================
// Mig Flares Car Wash — Prisma schema
// ---------------------------------------------------------------------
// Multi-branch ready from day one: every branch-scoped entity carries an
// optional `branchId`, so adding new branches / franchises later requires
// zero schema changes.
//
// Conventions: UUID primary keys, createdAt/updatedAt on all entities,
// enums for statuses, Decimal for money. Every relation column is typed
// @db.Uuid so foreign keys reference the UUID primary keys cleanly.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum RoleName {
  OWNER
  MANAGER
  CASHIER
  ATTENDANT
}

enum WashStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  TRUCK
  VAN
  MOTORCYCLE
  BUS
  OTHER
}

enum VehicleStatus {
  ACTIVE
  IN_SERVICE
  RETIRED
}

enum ServiceCategory {
  EXTERIOR
  INTERIOR
  FULL
  DETAILING
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  VIP
  BLACKLISTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PaymentStatus {
  PAID
  PARTIAL
  REFUNDED
  VOIDED
}

enum MovementType {
  RESTOCK
  ADJUSTMENT
  ISSUE
  WRITE_OFF
}

enum InventoryCategory {
  CLEANING_CHEMICALS
  EQUIPMENT
  CONSUMABLES
  SUPPLIES
  OTHER
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  FUEL
  EQUIPMENT
  CLEANING_CHEMICALS
  REPAIRS
  STAFF_SALARIES
  MARKETING
  MISC
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CASUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

enum PayslipStatus {
  DRAFT
  PAID
}

// ---------------------------------------------------------------------
// Roles & branches
// ---------------------------------------------------------------------

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            RoleName         @unique
  description     String?
  isActive        Boolean          @default(true)
  permissions     Json? // legacy: e.g. ["customers:write"] — superseded by rolePermissions
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // e.g. "reports:view"
  module      String           // e.g. "REPORTS"
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Branch {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  location  String
  phone     String?
  isActive  Boolean @default(true)
  users        User[]
  employees    Employee[]
  customers    Customer[]
  vehicles     Vehicle[]
  services     Service[]
  washRecords  WashRecord[]
  bookings     Booking[]
  receipts     Receipt[]
  auditLogs    AuditLog[]
  settings     Settings[]
  inventoryItems   InventoryItem[]
  inventoryMovements InventoryMovement[]
  expenses         Expense[]
  notifications    Notification[]
  salaryPayments   SalaryPayment[]
  timeEntries      TimeEntry[]
  attendanceRecords AttendanceRecord[]
  payrollRules     PayrollRule[]
  leaveRequests    LeaveRequest[]
  payrollRuns      PayrollRun[]
  payslips         Payslip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------
// Users & staff
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String?  @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  roleId       String   @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  branchId     String?  @db.Uuid
  branch       Branch?  @relation(fields: [branchId], references: [id])
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  refreshToken String?  @db.Text // rotated on login, cleared on logout
  employees      Employee[]
  assignedWashes WashRecord[] @relation("AssignedWashes")
  notifications  Notification[]
  auditLogs      AuditLog[]
  issuedReceipts Receipt[]
  voidedReceipts Receipt[] @relation("VoidedReceipts")
  createdBookings Booking[] @relation("CreatedBookings")
  settingsUpdated Settings[] @relation("SettingsUpdatedBy")
  inventoryMovements InventoryMovement[] @relation("InventoryMovements")
  createdExpenses  Expense[] @relation("CreatedExpenses")
  approvedExpenses Expense[] @relation("ApprovedExpenses")
  salaryPayments   SalaryPayment[] @relation("SalaryPaymentsCreated")
  attendanceCorrections AttendanceRecord[] @relation("AttendanceCorrected")
  leaveReviews          LeaveRequest[] @relation("LeaveReviewed")
  payrollRulesUpdated   PayrollRule[] @relation("PayrollRulesUpdated")
  payrollRunsGenerated  PayrollRun[] @relation("PayrollRunsGenerated")
  payrollRunsProcessed  PayrollRun[] @relation("PayrollRunsProcessed")
  payrollRunsPaid       PayrollRun[] @relation("PayrollRunsPaid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([branchId])
}

model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  phone     String
  email     String?
  avatarUrl String?
  nrcNumber String?  @unique
  position  String
  hireDate  DateTime @default(now())
  salary    Decimal? @db.Decimal(12, 2)
  payday    Int? // preferred pay day of the month (1-28) — used by payroll runs
  employmentType EmploymentType @default(FULL_TIME)
  payrollEnabled Boolean @default(true) // included in payroll runs
  attendanceRequired Boolean @default(true) // auto-clock via login when true
  overtimeEligible Boolean @default(true)
  emergencyContact Json? // { name, phone, relation }
  notes     String?
  isActive  Boolean  @default(true)
  userId    String?  @unique @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId  String?  @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id])
  washRecords WashRecord[]
  expenses     Expense[]
  bookings     Booking[]
  salaryPayments SalaryPayment[]
  timeEntries    TimeEntry[]
  attendanceRecords AttendanceRecord[]
  leaveRequests    LeaveRequest[]
  payslips         Payslip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([isActive])
}

// ---------------------------------------------------------------------
// Payroll & time tracking
// ---------------------------------------------------------------------

model SalaryPayment {
  id          String        @id @default(uuid()) @db.Uuid
  employeeId  String        @db.Uuid
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String        // e.g. "2026-07" — one payment per employee per month
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod
  notes       String?
  createdById String?       @db.Uuid
  createdBy   User?         @relation("SalaryPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  branchId    String?       @db.Uuid
  branch      Branch?       @relation(fields: [branchId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([employeeId, month])
  @@index([branchId])
}

model TimeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockInAt   DateTime @default(now())
  clockOutAt  DateTime?
  hoursWorked Decimal? @db.Decimal(10, 2) // computed on clock-out
  notes       String?
  attendance  AttendanceRecord?
  branchId    String?  @db.Uuid
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([clockInAt])
  @@index([branchId])
}

// Per-employee-per-day attendance snapshot. Auto-created on first login of the
// day (source LOGIN) or via the clock buttons, then updated on End Shift.
// TimeEntry remains the raw shift clock; AttendanceRecord is the payroll input.
model AttendanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  employeeId    String           @db.Uuid
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime // start-of-day of the shift (same helper everywhere)
  status        AttendanceStatus @default(PRESENT)
  clockInAt     DateTime?
  clockOutAt    DateTime?
  hoursWorked   Decimal?         @db.Decimal(10, 2) // regular hours, capped at standard day
  overtimeHours Decimal?         @db.Decimal(10, 2) // hours beyond the daily threshold
  overtimeMinutes Int            @default(0)
  source        String           @default("MANUAL") // LOGIN | CLOCK_BUTTON | MANUAL | SEED
  timeEntryId   String?          @unique @db.Uuid
  timeEntry     TimeEntry?       @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  notes         String?
  correctedById String?          @db.Uuid
  correctedBy   User?            @relation("AttendanceCorrected", fields: [correctedById], references: [id], onDelete: SetNull)
  correctedAt   DateTime?
  branchId      String?          @db.Uuid
  branch        Branch?          @relation(fields: [branchId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([branchId])
}

// Leave requests + approvals. Used days are derived from APPROVED requests.
model LeaveRequest {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         LeaveType  @default(ANNUAL)
  startDate    DateTime
  endDate      DateTime
  days         Decimal    @db.Decimal(5, 1)
  status       LeaveStatus @default(PENDING)
  reason       String?
  reviewedById String?    @db.Uuid
  reviewedBy   User?      @relation("LeaveReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  branchId     String?    @db.Uuid
  branch       Branch?    @relation(fields: [branchId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([branchId])
}

// One payroll rule per branch — start time, grace, OT policy, deductions and
// earning flags used when generating a payroll run. Manual per-run amounts
// (loan, damages, cash shortage) are entered at generation, not stored here.
model PayrollRule {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @default("Default Payroll Rule")
  branchId    String?   @unique @db.Uuid
  branch      Branch?   @relation(fields: [branchId], references: [id])
  startTime   String    @default("08:00") // shift start HH:mm
  graceMinutes Int      @default(15) // tolerated late arrival before LATE
  standardMinutesPerDay Int @default(480) // 8h
  overtimeRate Decimal  @default(1.5) @db.Decimal(4, 2) // multiplier × hourly rate
  dailyOvertimeThresholdMin Int @default(600) // hours beyond this are overtime
  defaultPayday Int     @default(25) // day of month (1-28)
  bonusEnabled    Boolean @default(true)
  overtimeEnabled Boolean @default(true)
  allowancesEnabled Boolean @default(true)
  deductionLoan    Decimal @default(0) @db.Decimal(12, 2)
  deductionDamages Decimal @default(0) @db.Decimal(12, 2)
  deductionUniform Decimal @default(0) @db.Decimal(12, 2)
  deductionTransport Decimal @default(0) @db.Decimal(12, 2)
  deductionMeals   Decimal @default(0) @db.Decimal(12, 2)
  deductionAdvances Decimal @default(0) @db.Decimal(12, 2)
  deductionOther   Decimal @default(0) @db.Decimal(12, 2)
  notes        String?
  updatedById  String?   @db.Uuid
  updatedBy    User?     @relation("PayrollRulesUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A monthly payroll generation for a branch. Status lifecycle: DRAFT →
// PROCESSED (amounts locked) → PAID (all payslips settled).
model PayrollRun {
  id            String           @id @default(uuid()) @db.Uuid
  branchId      String?          @db.Uuid
  branch        Branch?          @relation(fields: [branchId], references: [id])
  periodMonth   String // "2026-07"
  status        PayrollRunStatus @default(DRAFT)
  ruleSnapshot  Json? // copy of the PayrollRule used at generation
  totalGross    Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal         @default(0) @db.Decimal(14, 2)
  totalNet      Decimal          @default(0) @db.Decimal(14, 2)
  employeeCount Int              @default(0)
  generatedById String?          @db.Uuid
  generatedBy   User?            @relation("PayrollRunsGenerated", fields: [generatedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  processedById String?          @db.Uuid
  processedBy   User?            @relation("PayrollRunsProcessed", fields: [processedById], references: [id], onDelete: SetNull)
  paidAt        DateTime?
  paidById      String?          @db.Uuid
  paidBy        User?            @relation("PayrollRunsPaid", fields: [paidById], references: [id], onDelete: SetNull)
  notes         String?
  payslips      Payslip[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([branchId, periodMonth])
  @@index([branchId])
  @@index([status])
  @@index([periodMonth])
}

// Per-employee line item of a payroll run. Net = Base + (OT + Bonus +
// Allowances) − deductions. Per-run manual amounts land in the deduction
// fields here so runs can be adjusted without mutating the global rule.
model Payslip {
  id            String        @id @default(uuid()) @db.Uuid
  runId         String        @db.Uuid
  run           PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId    String        @db.Uuid
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Decimal       @default(0) @db.Decimal(12, 2)
  overtimeHours Decimal       @default(0) @db.Decimal(10, 2)
  overtimeAmount Decimal      @default(0) @db.Decimal(12, 2)
  bonusAmount   Decimal       @default(0) @db.Decimal(12, 2)
  allowancesAmount Decimal    @default(0) @db.Decimal(12, 2)
  grossAmount   Decimal       @default(0) @db.Decimal(12, 2)
  deductionLoan    Decimal    @default(0) @db.Decimal(12, 2)
  deductionDamages Decimal    @default(0) @db.Decimal(12, 2)
  deductionUniform Decimal    @default(0) @db.Decimal(12, 2)
  deductionTransport Decimal @default(0) @db.Decimal(12, 2)
  deductionMeals  Decimal     @default(0) @db.Decimal(12, 2)
  deductionAdvances Decimal   @default(0) @db.Decimal(12, 2)
  deductionOther  Decimal     @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal     @default(0) @db.Decimal(12, 2)
  netAmount       Decimal     @default(0) @db.Decimal(12, 2)
  workedDays      Int         @default(0)
  absentDays      Int         @default(0)
  leaveDays       Int         @default(0)
  status        PayslipStatus @default(DRAFT)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  branchId      String?       @db.Uuid
  branch        Branch?       @relation(fields: [branchId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([runId])
  @@index([branchId])
}

// ---------------------------------------------------------------------
// Customers & vehicles
// ---------------------------------------------------------------------

model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  firstName  String
  lastName   String
  phone      String
  email      String?
  address    String?
  notes      String?
  avatarUrl  String?
  status     CustomerStatus @default(ACTIVE)
  branchId   String?        @db.Uuid
  branch     Branch?        @relation(fields: [branchId], references: [id])
  vehicles   Vehicle[]
  washRecords WashRecord[]
  bookings   Booking[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastVisitAt DateTime?

  @@index([phone])
  @@index([status])
  @@index([branchId])
  @@index([lastVisitAt])
}

model Vehicle {
  id          String       @id @default(uuid()) @db.Uuid
  plateNumber String       @unique
  make        String
  model       String
  year        Int?
  color       String
  vehicleType VehicleType  @default(SEDAN)
  imageUrl    String?
  status      VehicleStatus @default(ACTIVE)
  customerId  String       @db.Uuid
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId    String?      @db.Uuid
  branch      Branch?      @relation(fields: [branchId], references: [id])
  washRecords WashRecord[]
  bookings    Booking[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastWashAt  DateTime?

  @@index([customerId])
  @@index([vehicleType])
  @@index([branchId])
}

// ---------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------

model Service {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal         @db.Decimal(12, 2)
  durationMin Int?
  category    ServiceCategory @default(EXTERIOR)
  icon        String? // lucide icon key, e.g. "Droplets", "Sparkles"
  colour      String? @default("#F47B20")
  displayOrder Int            @default(0)
  isActive    Boolean         @default(true)
  branchId    String?         @db.Uuid
  branch      Branch?         @relation(fields: [branchId], references: [id])
  washRecords WashRecord[]
  bookings    Booking[]
  inventoryRequired ServiceInventoryRequirement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive])
  @@index([category])
  @@index([branchId])
}

model ServiceInventoryRequirement {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @db.Uuid
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItemId String   @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3) // e.g. 100 (ml), 15 (g)

  @@unique([serviceId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryItem {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  sku               String            @unique
  category          InventoryCategory @default(CLEANING_CHEMICALS)
  supplier          String?
  unit              String            @default("unit")
  costPrice         Decimal           @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal           @default(0) @db.Decimal(12, 2)
  quantityAvailable Decimal           @default(0) @db.Decimal(12, 3)
  minimumQuantity   Decimal           @default(0) @db.Decimal(12, 3)
  maximumQuantity   Decimal           @default(0) @db.Decimal(12, 3)
  reorderLevel      Decimal           @default(0) @db.Decimal(12, 3)
  storageLocation   String?
  lastRestocked     DateTime?
  isActive          Boolean           @default(true)
  branchId          String?           @db.Uuid
  branch            Branch?           @relation(fields: [branchId], references: [id])
  movements         InventoryMovement[]
  serviceRequirements ServiceInventoryRequirement[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([branchId])
}

model InventoryMovement {
  id           String       @id @default(uuid()) @db.Uuid
  itemId       String       @db.Uuid
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type         MovementType
  quantity     Decimal      @db.Decimal(12, 3)
  balanceAfter Decimal      @db.Decimal(12, 3)
  reason       String?
  createdById  String?      @db.Uuid
  createdBy    User?        @relation("InventoryMovements", fields: [createdById], references: [id], onDelete: SetNull)
  branchId     String?      @db.Uuid
  branch       Branch?      @relation(fields: [branchId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([itemId])
  @@index([createdAt])
}

model Expense {
  id            String         @id @default(uuid()) @db.Uuid
  amount        Decimal        @db.Decimal(12, 2)
  category      ExpenseCategory
  vendor        String?
  description   String?
  receiptUrl    String?
  paymentMethod PaymentMethod
  expenseDate   DateTime
  status        ExpenseStatus  @default(PENDING)
  createdById   String?        @db.Uuid
  createdBy     User?          @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  employeeId    String?        @db.Uuid
  employee      Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  approvedById  String?        @db.Uuid
  approvedBy    User?          @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  branchId      String?        @db.Uuid
  branch        Branch?        @relation(fields: [branchId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([category])
  @@index([status])
  @@index([expenseDate])
  @@index([branchId])
}

// ---------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------

model WashRecord {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique // e.g. WF-20260806-0001
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId     String        @db.Uuid
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceId     String        @db.Uuid
  service       Service       @relation(fields: [serviceId], references: [id])
  extras        Json? // [{ id, name, price }]
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  subtotal      Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  employeeId    String?       @db.Uuid
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedById  String?       @db.Uuid
  assignedBy    User?         @relation("AssignedWashes", fields: [assignedById], references: [id], onDelete: SetNull)
  notes         String?
  status        WashStatus    @default(PENDING)
  beforePhotos  Json? // string[] — Cloudinary URLs
  afterPhotos   Json? // string[] — Cloudinary URLs
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  branchId      String?       @db.Uuid
  branch        Branch?       @relation(fields: [branchId], references: [id])
  receipts      Receipt[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
  @@index([branchId])
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  reference   String        @unique // e.g. BK-20260806-0001
  customerId  String        @db.Uuid
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId   String        @db.Uuid
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceId   String        @db.Uuid
  service     Service       @relation(fields: [serviceId], references: [id])
  employeeId  String?       @db.Uuid
  employee    Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  durationMin Int           @default(30)
  status      BookingStatus @default(PENDING)
  notes       String?
  createdById String?       @db.Uuid
  createdBy   User?         @relation("CreatedBookings", fields: [createdById], references: [id], onDelete: SetNull)
  branchId    String?       @db.Uuid
  branch      Branch?       @relation(fields: [branchId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([scheduledAt])
  @@index([status])
  @@index([branchId])
}

model Receipt {
  id           String        @id @default(uuid()) @db.Uuid
  receiptNo    String        @unique // e.g. RCP-20260806-0001
  // Not unique: duplicates of a receipt (reprints/copies) share the wash record.
  washRecordId String        @db.Uuid
  washRecord   WashRecord    @relation(fields: [washRecordId], references: [id], onDelete: Cascade)
  originalReceiptId String?  @db.Uuid
  originalReceipt   Receipt?  @relation("ReceiptCopies", fields: [originalReceiptId], references: [id], onDelete: SetNull)
  copies            Receipt[] @relation("ReceiptCopies")
  items        Json // [{ name, price }]
  subtotal     Decimal       @db.Decimal(12, 2)
  discount     Decimal       @db.Decimal(12, 2)
  tax          Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  amountPaid   Decimal       @db.Decimal(12, 2)
  changeDue    Decimal       @db.Decimal(12, 2) @default(0)
  paymentMethod PaymentMethod
  status       PaymentStatus @default(PAID)
  voidReason   String?
  voidedAt     DateTime?
  voidedById   String?       @db.Uuid
  voidedBy     User?         @relation("VoidedReceipts", fields: [voidedById], references: [id], onDelete: SetNull)
  issuedById   String        @db.Uuid
  issuedBy     User          @relation(fields: [issuedById], references: [id])
  branchId     String?       @db.Uuid
  branch       Branch?       @relation(fields: [branchId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([washRecordId])
  @@index([originalReceiptId])
  @@index([issuedById])
  @@index([createdAt])
  @@index([status])
  @@index([branchId])
}

// ---------------------------------------------------------------------
// System
// ---------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  category  String           @default("SYSTEM") // SYSTEM | INVENTORY | WASH | EXPENSE | EMPLOYEE | REMINDER
  isRead    Boolean          @default(false)
  readAt    DateTime?
  branchId  String?          @db.Uuid
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([category])
  @@index([branchId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId  String?  @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  action    String // e.g. "CUSTOMER_CREATED", "WASH_COMPLETED"
  entity    String // e.g. "Customer", "WashRecord"
  entityId  String?
  oldValue  Json?
  newValue  Json?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model Settings {
  id          String   @id @default(uuid()) @db.Uuid
  key         String // e.g. "currency", "tax_rate", "receipt_footer"
  value       Json
  branchId    String?  @db.Uuid
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([key, branchId])
}
