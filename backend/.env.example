# Mig Flares Car Wash - Backend environment
# Copy to .env and adjust. Never commit real secrets.
# For Render: set these in the dashboard (see render.yaml / docs/DEPLOYMENT.md).

NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/mig-flares?sslmode=require

# JWT secrets - use long random strings in production
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (server-side uploads via POST /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=car-wash

# CORS - comma-separated allowed origins
# Production: your Cloudflare Pages domain, e.g. https://mig-flares.pages.dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
