# ── Mig Flares Car Wash — Frontend environment ──────────────────────
# Copy to .env.local and adjust.
# For Cloudflare Pages: set VITE_API_URL to your Render API in Project Settings → Environment Variables.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# Cloudinary uploads are routed through the backend (POST /api/upload),
# which owns the Cloudinary credentials — no frontend Cloudinary vars are needed.
